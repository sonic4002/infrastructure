#!/usr/bin/env bash
# =============================================================================
# xo-cf-origin-fw -- allow TCP 443 and 80 on this node only from Cloudflare.
#
# Installed on the node as /usr/local/sbin/xo-cf-origin-fw (source of truth:
# infrastructure/common/host/). Port 443 is the hostNetwork tls-terminator
# (common/02-tls-terminator.yaml) for *.xoffice.cloud; port 80 is cilium-envoy
# (platform-gateway), which Cloudflare uses for chatflowpro.live (SSL Flexible).
# Every hostname on this node is Cloudflare-proxied. Nothing else is touched:
# 22, 6443, 10250 and every other port keep their current behaviour.
# Ports come from PORTS in /etc/default/xo-cf-origin-fw (default "443 80").
#
# Usage:
#   xo-cf-origin-fw apply      fetch Cloudflare's IPv4 ranges, (re)build the rule
#   xo-cf-origin-fw rollback   remove the rule entirely (443 open to the world)
#   xo-cf-origin-fw status     show the INPUT jump and the chain
#
# apply is atomic from the client's view: the new chain is built beside the old
# one, the INPUT jump is swapped, then the old chain is removed. If the fetch
# fails or returns an implausible list, the current rule is kept unchanged.
# IPv4 only: the node has no global IPv6 address. apply warns if it ever gets
# one, because v6 traffic on these ports would then bypass the rule.
# =============================================================================
set -euo pipefail

CHAIN_PREFIX="XO-CF443"   # name kept from the 443-only version; the chain serves every port in PORTS
PORTS="443 80"
[[ -r /etc/default/xo-cf-origin-fw ]] && . /etc/default/xo-cf-origin-fw
LIST_URL="https://api.cloudflare.com/client/v4/ips"
MIN_RANGES=10
CACHE="/var/lib/xo-cf-origin-fw/ipv4.txt"

log() { logger -t xo-cf-origin-fw -- "$*"; echo "$*"; }

current_chain() {
  iptables -S INPUT | awk '/xo-cf-origin-fw/ && /-j XO-CF443-/ {print $NF; exit}'
}

# Remove every INPUT jump to chain $1, whatever port it was for.
remove_jumps() {
  local c=$1 line
  while line=$(iptables -S INPUT | grep -m1 -- "-j $c\$"); do
    # shellcheck disable=SC2086
    iptables ${line/-A INPUT/-D INPUT}
  done
}

fetch_ranges() {
  local json
  json=$(curl -fsS --max-time 20 "$LIST_URL") || return 1
  python3 -c '
import json, sys, ipaddress
d = json.loads(sys.stdin.read())
if not d.get("success"): sys.exit(1)
for c in d["result"]["ipv4_cidrs"]:
    print(ipaddress.IPv4Network(c))
' <<<"$json"
}

apply() {
  local ranges n old new
  if ranges=$(fetch_ranges); then
    n=$(grep -c . <<<"$ranges" || true)
  else
    n=0
  fi
  if (( n < MIN_RANGES )); then
    if [[ -s "$CACHE" ]]; then
      log "fetch failed or returned $n ranges; using cached list $CACHE"
      ranges=$(cat "$CACHE"); n=$(grep -c . <<<"$ranges")
    else
      log "fetch failed or returned $n ranges and no cache; leaving firewall unchanged"
      exit 1
    fi
  else
    mkdir -p "$(dirname "$CACHE")"
    printf '%s\n' "$ranges" > "$CACHE"
  fi

  old=$(current_chain || true)
  if [[ "$old" == "${CHAIN_PREFIX}-A" ]]; then new="${CHAIN_PREFIX}-B"; else new="${CHAIN_PREFIX}-A"; fi

  iptables -N "$new" 2>/dev/null || iptables -F "$new"
  # Loopback first: the tls-terminator proxies decrypted 443 traffic to envoy at
  # 127.0.0.1:80, so port 80 must stay open on lo or every xoffice host breaks.
  iptables -A "$new" -i lo -j ACCEPT
  while read -r cidr; do
    [[ -n "$cidr" ]] && iptables -A "$new" -s "$cidr" -j ACCEPT
  done <<<"$ranges"
  iptables -A "$new" -j DROP

  # New jumps first (top of INPUT), then drop the old ones: no window without a rule.
  local p
  for p in $PORTS; do
    iptables -I INPUT 1 -p tcp --dport "$p" -m comment --comment "xo-cf-origin-fw" -j "$new"
  done
  if [[ -n "$old" ]]; then
    remove_jumps "$old"
    iptables -F "$old" 2>/dev/null || true
    iptables -X "$old" 2>/dev/null || true
  fi
  if ip -6 addr show scope global 2>/dev/null | grep -q inet6; then
    log "WARNING: node has a global IPv6 address; ports $PORTS are NOT restricted on IPv6"
  fi
  log "applied: ports $PORTS allowed from $n Cloudflare IPv4 ranges (chain $new)"
}

rollback() {
  local c
  for c in "${CHAIN_PREFIX}-A" "${CHAIN_PREFIX}-B"; do
    remove_jumps "$c"
    iptables -F "$c" 2>/dev/null || true
    iptables -X "$c" 2>/dev/null || true
  done
  log "rolled back: ports open to all sources"
}

status() {
  iptables -S INPUT | grep -E "XO-CF443" || echo "no xo-cf-origin-fw rule in INPUT"
  local c; c=$(current_chain || true)
  [[ -n "$c" ]] && iptables -L "$c" -n -v --line-numbers
  return 0
}

case "${1:-}" in
  apply) apply ;;
  rollback) rollback ;;
  status) status ;;
  *) echo "usage: $0 apply|rollback|status" >&2; exit 2 ;;
esac
